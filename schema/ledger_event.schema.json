{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dot-market-monitor.local/schema/ledger_event.schema.json",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "input": {
      "$ref": "https://dot-market-monitor.local/schema/ledger_input.schema.json"
    },
    "input_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "previous_state_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "effects": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "type",
          "at_utc",
          "input_sha256"
        ],
        "properties": {
          "type": {
            "type": "string",
            "minLength": 1
          },
          "at_utc": {
            "type": "string",
            "format": "date-time"
          },
          "input_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      }
    },
    "state_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "state_document_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  },
  "required": [
    "input",
    "input_sha256",
    "previous_state_sha256",
    "effects",
    "state_sha256",
    "state_document_sha256"
  ]
}
